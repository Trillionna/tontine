{% extends 'base.html.twig' %}

{% block title %}Campagne{% endblock %}

{% block body %}
    <h1>Campagne</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ campagne.id }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ campagne.nom }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ campagne.description }}</td>
            </tr>
            <tr>
                <th>MontantCotisation</th>
                <td>{{ campagne.montantCotisation }}</td>
            </tr>
            <tr>
                <th>NombreMembresMax</th>
                <td>{{ campagne.nombreMembresMax }}</td>
            </tr>
            <tr>
                <th>DateDebut</th>
                <td>{{ campagne.dateDebut ? campagne.dateDebut|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>DateFin</th>
                <td>{{ campagne.dateFin ? campagne.dateFin|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Statut</th>
                <td>{{ campagne.statut }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_campagne_index') }}">back to list</a>

    <a href="{{ path('app_campagne_edit', {'id': campagne.id}) }}">edit</a>

    {{ include('campagne/_delete_form.html.twig') }}
{% endblock %}
