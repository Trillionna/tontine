<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Tontine{% endblock %}</title>
    <style>
        :root{color-scheme:light;--bg:#f5f6fb;--surface:#fff;--text:#202039;--muted:#777e91;--primary:#7546e8;--border:#e9eaf1}
        *{box-sizing:border-box}
        body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,"Segoe UI",Arial,sans-serif;font-size:14px}
        a{color:inherit;text-decoration:none}
        .layout{display:flex;min-height:100vh}
        aside{width:245px;flex-shrink:0;background:#202039;color:white;padding:30px 18px}
        .brand{font-size:23px;font-weight:800;margin:0 12px 45px;letter-spacing:-.7px}.brand span{color:#bca5ff}
        .nav-label{margin:25px 12px 12px;color:#a6a5bd;font-size:10px;font-weight:800;letter-spacing:1.5px}
        .nav-item{display:block;padding:13px 12px;margin:5px 0;border-radius:9px;color:#e1e0ef;font-size:14px}
        .nav-item:hover,.nav-item.active{background:#7546e8;color:white}
        main{flex:1;min-width:0;padding:36px}
        .page-heading{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:28px}
        h1{font-size:29px;margin:8px 0;letter-spacing:-.8px}h2{font-size:17px;margin:0 0 7px}
        .eyebrow{font-size:10px;letter-spacing:1.5px;font-weight:800;color:var(--primary)}
        .eyebrow a{color:var(--primary)}.muted{color:var(--muted);margin:0;line-height:1.6}
        .button{display:inline-flex;align-items:center;justify-content:center;gap:8px;border:0;border-radius:9px;padding:12px 16px;font:inherit;font-weight:700;cursor:pointer;white-space:nowrap}
        .primary{background:var(--primary);color:white}.primary:hover{background:#6234d2}
        .secondary{background:white;color:#45465b;border:1px solid var(--border)}
        .stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-bottom:25px}
        .stat-card,.panel,.form-panel{background:var(--surface);border:1px solid var(--border);border-radius:15px;box-shadow:0 4px 15px #20203905}
        .stat-card{padding:21px}.stat-label{display:block;color:var(--muted);font-size:12px}.stat-card strong{display:block;font-size:29px;margin:12px 0 5px}.stat-note{font-size:11px;color:var(--muted)}
        .panel{overflow:hidden}.panel-heading{padding:23px 24px 18px}
        .filters{display:flex;gap:10px;padding:0 24px 20px;flex-wrap:wrap}
        input,select{font:inherit;color:var(--text);background:white;border:1px solid #dfe1eb;border-radius:8px;padding:12px}
        .filters input{flex:1;min-width:210px}.filters select{min-width:155px}
        input:focus,select:focus{outline:2px solid #d9ccff;border-color:var(--primary)}
        .table-wrap{width:100%;overflow-x:auto}
        table{width:100%;border-collapse:collapse;text-align:left;white-space:nowrap}
        thead{background:#fafaff}th{font-size:10px;letter-spacing:.8px;text-transform:uppercase;color:var(--muted);font-weight:800}
        th,td{padding:16px 20px;border-top:1px solid #f0f0f6}td{font-size:12px}td strong{font-size:13px}td small{display:block;color:var(--muted);font-size:11px;margin-top:5px}
        .member-cell{display:flex;align-items:center;gap:12px}.avatar{width:39px;height:39px;display:grid;place-items:center;border-radius:12px;background:#f0eaff;color:var(--primary);font-weight:800}
        .badge{display:inline-block;padding:6px 10px;border-radius:20px;font-size:10px;font-weight:800}
        .badge-actif{background:#e5f8ed;color:#168451}.badge-en_attente{background:#fff4d8;color:#946500}.badge-suspendu{background:#fff0e8;color:#b45b22}.badge-exclu{background:#ffe8ec;color:#b4233a}
        .actions{display:flex;align-items:center;gap:6px}.actions form{margin:0}.icon-button{display:grid;place-items:center;width:32px;height:32px;background:white;border:1px solid var(--border);border-radius:8px;cursor:pointer;font-size:16px;color:#59536e}.icon-button:hover{background:#f4f0ff}.icon-button.delete{color:#c33349}.icon-button.activate{color:#168451}
        .actions-head{text-align:center}.table-footer{padding:16px 24px;border-top:1px solid var(--border);color:var(--muted);font-size:11px}
        .empty-state{text-align:center;padding:45px 15px;white-space:normal}.empty-state p{color:var(--muted);margin:8px 0 18px}
        .form-panel{max-width:850px;padding:28px}.form-intro{display:flex;gap:13px;align-items:center;padding-bottom:24px;border-bottom:1px solid var(--border);margin-bottom:24px}.form-icon{width:43px;height:43px;border-radius:12px;display:grid;place-items:center;background:#f0eaff;color:var(--primary);font-size:24px}
        .form-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px}
        .form-grid>div{min-width:0}.form-grid label{display:block;font-size:12px;font-weight:700;margin-bottom:8px}
        .form-grid input{width:100%;padding:13px}.form-grid ul{padding-left:18px;color:#c33349;font-size:12px}
        .form-actions{display:flex;justify-content:flex-end;gap:10px;border-top:1px solid var(--border);padding-top:23px;margin-top:28px}
        .alert{padding:12px 15px;border-radius:8px;margin:12px 0}.alert.error{background:#fff0f0;color:#b4233a}
        .flash{padding:13px 16px;border-radius:9px;margin-bottom:18px}.flash.success{background:#e5f8ed;color:#168451}.flash.error{background:#fff0f0;color:#b4233a}
        @media(max-width:1000px){.stats{grid-template-columns:repeat(2,minmax(0,1fr))}aside{width:205px}main{padding:25px}}
        @media(max-width:700px){.layout{display:block}aside{width:100%;padding:18px}.brand{margin:0 8px 15px}.nav-label{margin:12px 8px}.nav-item{display:inline-block;margin:2px;padding:10px}main{padding:20px 14px}.page-heading{align-items:flex-start;flex-direction:column}.stats{gap:10px}.stat-card{padding:15px}.stat-card strong{font-size:24px}.form-grid{grid-template-columns:1fr}.form-panel{padding:20px}.filters>*{width:100%}}
    </style>
</head>
<body>
<div class="layout">
    <aside>
        <div class="brand">Tontine<span>.</span></div>
        <div class="nav-label">ESPACE PRINCIPAL</div>
        <a class="nav-item" href="{{ path('app_dashboard') }}">⌂ &nbsp; Tableau de bord</a>
        <a class="nav-item active" href="{{ path('app_membre_index') }}">◉ &nbsp; Membres</a>
        <div class="nav-label">GESTION</div>
        <a class="nav-item" href="{{ path('app_campagne_index') }}">Campagnes</a>
        <a class="nav-item" href="{{ path('app_participation_index') }}">Participations</a>
        <a class="nav-item" href="{{ path('app_cotisation_index') }}">Cotisations</a>
        <a class="nav-item" href="{{ path('app_paiement_index') }}">Paiements</a>
        <a class="nav-item" href="{{ path('app_tour_index') }}">Tours</a>
        <div class="nav-label">SYSTÈME</div>
        <a class="nav-item" href="#">⚙ &nbsp; Paramètres</a>
    </aside>
    <main>
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="flash {{ type }}">{{ message }}</div>
            {% endfor %}
        {% endfor %}
        {% block body %}{% endblock %}
    </main>
</div>
</body>
</html>