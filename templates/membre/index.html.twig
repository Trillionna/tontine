{% extends 'base_membres.html.twig' %}

{% block title %}Gestion des membres | Tontine{% endblock %}

{% block body %}
<div class="page-heading">
    <div>
        <div class="eyebrow">GESTION / MEMBRES</div>
        <h1>Gestion des membres</h1>
        <p class="muted">Consultez et gérez les membres inscrits à la tontine.</p>
    </div>
    <a class="button primary" href="{{ path('app_membre_new') }}">＋ Nouveau membre</a>
</div>

<div class="stats">
    <div class="stat-card"><span class="stat-label">Total des membres</span><strong>{{ total }}</strong><span class="stat-note">Membres enregistrés</span></div>
    <div class="stat-card"><span class="stat-label">Membres actifs</span><strong>{{ actifs }}</strong><span class="stat-note">Participation active</span></div>
    <div class="stat-card"><span class="stat-label">En attente</span><strong>{{ attente }}</strong><span class="stat-note">À examiner</span></div>
    <div class="stat-card"><span class="stat-label">Suspendus</span><strong>{{ suspendus }}</strong><span class="stat-note">Accès suspendu</span></div>
</div>

<div class="panel">
    <div class="panel-heading">
        <div><h2>Répertoire des membres</h2><p class="muted">Recherchez et gérez les dossiers existants.</p></div>
    </div>

    <form method="get" action="{{ path('app_membre_index') }}" class="filters">
        <input type="search" name="q" value="{{ recherche }}" placeholder="Rechercher un nom, un e-mail, un téléphone…">
        <select name="statut" aria-label="Filtrer par statut">
            <option value="">Tous les statuts</option>
            <option value="actif" {% if statutFiltre == 'actif' %}selected{% endif %}>Actif</option>
            <option value="en_attente" {% if statutFiltre == 'en_attente' %}selected{% endif %}>En attente</option>
            <option value="suspendu" {% if statutFiltre == 'suspendu' %}selected{% endif %}>Suspendu</option>
            <option value="exclu" {% if statutFiltre == 'exclu' %}selected{% endif %}>Exclu</option>
        </select>
        <button class="button primary" type="submit">Filtrer</button>
        <a class="button secondary" href="{{ path('app_membre_index') }}">Réinitialiser</a>
    </form>

    <div class="table-wrap">
        <table>
            <thead><tr><th>Membre</th><th>Contact</th><th>Inscription</th><th>Statut</th><th class="actions-head">Actions</th></tr></thead>
            <tbody>
            {% for membre in membres %}
                <tr>
                    <td>
                        <div class="member-cell">
                            <div class="avatar">{{ membre.prenom|first|upper }}{{ membre.nom|first|upper }}</div>
                            <div><strong>{{ membre.prenom }} {{ membre.nom }}</strong><small>Référence #{{ membre.id }}</small></div>
                        </div>
                    </td>
                    <td><div>{{ membre.email }}</div><small>{{ membre.telephone }}</small></td>
                    <td>{{ membre.dateInscription ? membre.dateInscription|date('d/m/Y') : '—' }}</td>
                    <td><span class="badge badge-{{ membre.statut.value }}">{{ membre.statut.value|replace({'_':' '})|capitalize }}</span></td>
                    <td>
                        <div class="actions">
                            <a class="icon-button" href="{{ path('app_membre_edit', {id: membre.id}) }}" title="Modifier" aria-label="Modifier">✎</a>
                            {% if membre.statut.value == 'actif' %}
                                <form method="post" action="{{ path('app_membre_statut', {id: membre.id, statut: 'suspendu'}) }}" onsubmit="return confirm('Suspendre ce membre ?')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('statut_membre_' ~ membre.id) }}">
                                    <button class="icon-button" title="Suspendre" aria-label="Suspendre">Ⅱ</button>
                                </form>
                            {% else %}
                                <form method="post" action="{{ path('app_membre_statut', {id: membre.id, statut: 'actif'}) }}" onsubmit="return confirm('Activer ce membre ?')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('statut_membre_' ~ membre.id) }}">
                                    <button class="icon-button activate" title="Activer" aria-label="Activer">✓</button>
                                </form>
                            {% endif %}
                            <form method="post" action="{{ path('app_membre_delete', {id: membre.id}) }}" onsubmit="return confirm('Supprimer définitivement ce membre ? Cette action peut être impossible si des opérations lui sont liées.')">
                                <input type="hidden" name="_token" value="{{ csrf_token('supprimer_membre_' ~ membre.id) }}">
                                <button class="icon-button delete" title="Supprimer" aria-label="Supprimer">×</button>
                            </form>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="5"><div class="empty-state"><strong>Aucun membre trouvé</strong><p>Modifiez les filtres ou ajoutez un nouveau membre.</p><a class="button primary" href="{{ path('app_membre_new') }}">Ajouter un membre</a></div></td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    <div class="table-footer">{{ membres|length }} résultat(s)</div>
</div>
{% endblock %}