{% extends 'base.html.twig' %}

{% block title %}Tour index{% endblock %}

{% block body %}
    <h1>Tour index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Numero</th>
                <th>DateTour</th>
                <th>MontantCagnotte</th>
                <th>EstCloture</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for tour in tours %}
            <tr>
                <td>{{ tour.id }}</td>
                <td>{{ tour.numero }}</td>
                <td>{{ tour.dateTour ? tour.dateTour|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ tour.montantCagnotte }}</td>
                <td>{{ tour.estCloture ? 'Yes' : 'No' }}</td>
                <td>
                    <a href="{{ path('app_tour_show', {'id': tour.id}) }}">show</a>
                    <a href="{{ path('app_tour_edit', {'id': tour.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_tour_new') }}">Create new</a>
{% endblock %}
